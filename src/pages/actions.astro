---
import BaseLayout from "../components/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <h1>Actions & Dispositifs</h1>
      <p>
        GRADD déploie des actions concrètes et des dispositifs adaptés aux besoins
        des institutions publiques et des projets de développement durable.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Études et analyses</h2>
      <ul>
        <li>Études formatives et diagnostics territoriaux</li>
        <li>Analyses de faisabilité et études de référence</li>
        <li>Identification des besoins et acteurs clés</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Mise en œuvre de projets</h2>
      <ul>
        <li>Accompagnement à la planification stratégique</li>
        <li>Déploiement de programmes éducatifs et sociaux</li>
        <li>Organisation de comités de veille et de développement communautaire</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Marketing social et communication</h2>
      <ul>
        <li>Campagnes de sensibilisation et communication institutionnelle</li>
        <li>Mobilisation des parties prenantes</li>
        <li>Supports pédagogiques et événementiels scientifiques</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Audit, contrôle et accompagnement</h2>
      <ul>
        <li>Audit de projets et programmes</li>
        <li>Contrôle de dispositifs et recommandations opérationnelles</li>
        <li>Accompagnement à l’amélioration continue</li>
      </ul>
    </div>
  </section>
</BaseLayout>
