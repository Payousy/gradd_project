---
import BaseLayout from "../components/layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout>
  <h1>Groupe de Recherche Appliqué au Développement Durable</h1>

  <p>
    GRADD accompagne les institutions publiques et organisations
    dans la conception, l’analyse et l’évaluation de projets de développement durable.
  </p>

  <Button>Nous contacter</Button>

  <section>
    <Card title="Études et analyses">
      <p>Études formatives, analyses situationnelles et recherches appliquées.</p>
    </Card>
  </section>
</BaseLayout>
