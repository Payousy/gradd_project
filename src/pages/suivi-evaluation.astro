---
import BaseLayout from "../components/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <h1>Suivi & Évaluation</h1>
      <p>
        GRADD met en place des dispositifs de suivi et d’évaluation pour garantir
        l’efficacité et l’impact de ses interventions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Objectifs du suivi</h2>
      <ul>
        <li>Assurer la bonne mise en œuvre des actions</li>
        <li>Mesurer l’efficacité et l’impact des projets</li>
        <li>Identifier les écarts et ajustements nécessaires</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Outils et indicateurs</h2>
      <ul>
        <li>Cadres logiques et théories du changement</li>
        <li>Indicateurs quantitatifs et qualitatifs</li>
        <li>Rapports d’avancement périodiques</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Amélioration continue</h2>
      <p>
        GRADD analyse les résultats obtenus et ajuste ses pratiques pour renforcer
        l’efficacité, la pertinence et la durabilité des interventions.
      </p>
    </div>
  </section>
</BaseLayout>