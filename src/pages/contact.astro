---
import BaseLayout from "../components/layouts/BaseLayout.astro";

// Cette page ne gère plus le POST côté page rendue.
// Le traitement du formulaire est déplacé dans `src/pages/api/contact.ts`.

const { message } = Astro.props;

let formError = "";
let formSubmitted = false;
---

<BaseLayout title="Contact – GRADD" description="Contactez GRADD pour vos projets de recherche appliquée, suivi-évaluation et développement durable.">
  <main class="contact-page">
    <section class="page-intro">
      <h1>Nous contacter</h1>
      <p>
        Vous avez un projet ou une question ? Nous serions ravis d'échanger avec vous.
        Remplissez le formulaire ci-dessous et nous vous répondrons rapidement.
      </p>
    </section>

    <section class="contact-section">
      <div class="contact-grid">
        <!-- Formulaire -->
        <div class="contact-form-wrapper">
          {formSubmitted && (
            <div class="success-message">
              ✓ Merci pour votre message ! Nous vous répondrons sous peu.
            </div>
          )}
          {formError && (
            <div class="error-message">
              ✗ {formError}
            </div>
          )}

          <form name="contact" method="POST" class="contact-form" data-netlify="true" action="/merci">
            <input type="hidden" name="form-name" value="contact" />
            <div class="form-group">
              <label for="name">Nom complet *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Votre nom"
              />
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="votre@email.com"
              />
            </div>

            <div class="form-group">
              <label for="subject">Sujet</label>
              <input
                type="text"
                id="subject"
                name="subject"
                autocomplete="off"
                placeholder="Objet de votre demande"
              />
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                autocomplete="off"
                rows="6"
                placeholder="Décrivez votre projet ou votre question..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary">Envoyer</button>
          </form>
        </div>

        <!-- Informations de contact -->
        <div class="contact-info">
          <div class="info-block">
            <h3>Email</h3>
            <p>
              <a href="mailto:payoussy@hotmail.fr">contact@gradd.com</a>
            </p>
          </div>

          <div class="info-block">
            <h3>Adresse</h3>
            <p>
              GRADD<br />
              Dakar, Sénégal
            </p>
          </div>

          <div class="info-block">
            <h3>Réseaux sociaux</h3>
            <p>
              Suivez-nous pour rester informé de nos actualités et publications.
            </p>
          </div>

          <div class="info-block">
            <h3>Disponibilité</h3>
            <p>
              Lundi - Vendredi<br />
              9h00 - 17h00 (GMT+1)
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .contact-page {
      padding: 3rem 1rem;
    }

    .page-intro {
      text-align: center;
      margin-bottom: 3rem;
    }

    .page-intro h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .contact-section {
      max-width: 1200px;
      margin: 0 auto;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .page-intro h1 {
        font-size: 2rem;
      }
    }

    .contact-form-wrapper {
      background: #f9fafb;
      padding: 2rem;
      border-radius: 8px;
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-dark);
    }

    .form-group input,
    .form-group textarea {
      padding: 0.75rem 1rem;
      border: 1px solid #e5e7eb;
      border-radius: 4px;
      font-family: var(--font-base);
      font-size: 1rem;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(11, 79, 108, 0.1);
    }

    .contact-form button {
      padding: 0.75rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      align-self: flex-start;
    }

    .success-message {
      background-color: #d1fae5;
      color: #065f46;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
      border-left: 4px solid #10b981;
    }

    .error-message {
      background-color: #fee2e2;
      color: #991b1b;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
      border-left: 4px solid #ef4444;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .info-block {
      background: white;
      padding: 1.5rem;
      border-left: 4px solid var(--color-primary);
      border-radius: 4px;
    }

    .info-block h3 {
      margin-top: 0;
      color: var(--color-secondary);;
      font-size: 1.2rem;
    }

    .info-block p {
      margin: 0.5rem 0;
      color: var(--color-grey);
    }

    .info-block a {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 600;
    }

    .info-block a:hover {
      text-decoration: underline;
    }

    .btn-primary {
      background-color: var(--color-primary);
      color: white;
      padding: 0.75rem 2rem;
      border: none;
      border-radius: 4px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .btn-primary:hover {
      background-color: #083a52;
    }
  </style>
</BaseLayout>
